@tailwind base;
@tailwind components;
@tailwind utilities;

@import "tw-animate-css";

@import "@fontsource-variable/inter";

/* ═══════════════════════════════════════════════════════════════════════════
   GLOBAL DESIGN SYSTEM — DentalCare Pro

   HOW TO THEME FOR A DIFFERENT CUSTOMER:
   Change the CSS custom properties in :root below.
   All components use these variables via Tailwind's arbitrary value syntax
   OR via the utility classes defined in @layer components.

   Example for a green-themed clinic:
     --brand-600: 22 163 74;       (green-600)
     --brand-700: 21 128 61;       (green-700)
     --brand-50:  240 253 244;     (green-50)
   ═══════════════════════════════════════════════════════════════════════════ */

@layer base {
  :root {
    /* Brand palette (RGB triplets for Tailwind opacity helpers) */
    --brand-50: 239 246 255;
    --brand-100: 219 234 254;
    --brand-200: 191 219 254;
    --brand-500: 59 130 246;
    --brand-600: 37 99 235;
    --brand-700: 29 78 216;
    --brand-800: 30 64 175;

    /* Centralized Color System (RGB Triplets) */
    --primary: 15 23 42;
    --secondary: 241 245 249;
    --ternary: 59 130 246;
    --card-bg: 255 255 255;
    --surface: 248 250 252;
    --border: 226 232 240;

    /* Shadcn UI Variables (RGB compatible) */
    --background: 255 255 255;
    --foreground: 15 23 42;
    --muted: 241 245 249;
    --muted-foreground: 100 116 139;
    --popover: 255 255 255;
    --popover-foreground: 15 23 42;
    --card: 255 255 255;
    --card-foreground: 15 23 42;
    --accent: 241 245 249;
    --accent-foreground: 15 23 42;
    --destructive: 239 68 68;
    --destructive-foreground: 255 255 255;
    --ring: 59 130 246;
    --input: 226 232 240;

    /* Radius scale */
    --radius-sm: 0.5rem;
    --radius-md: 0.75rem;
    --radius-lg: 1rem;
    --radius: 0.625rem;

    /* Typography scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.875rem;
    --fs-base: 1rem;
    --fs-lg: 1.125rem;
    --fs-xl: 1.25rem;
  }
}
