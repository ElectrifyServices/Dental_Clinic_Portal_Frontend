{
  "formId": "emr",
  "version": "1.0.0",
  "title": {
    "create": "Add EMR Record",
    "edit": "Edit EMR Record"
  },
  "submitLabel": { "create": "Save Record", "edit": "Update Record" },
  "cancelLabel": "Cancel",
  "sections": [
    {
      "id": "recordInfo",
      "title": "Record Details",
      "icon": "FileText",
      "fields": [
        {
          "name": "patientName",
          "label": "Patient Name",
          "type": "select",
          "required": true,
          "placeholder": "Select patient",
          "colSpan": 6,
          "options": []
        },
        {
          "name": "type",
          "label": "Record Type",
          "type": "select",
          "required": true,
          "colSpan": 6,
          "options": [
            { "value": "previous-prescriptions", "label": "Previous Prescriptions" },
            { "value": "blood-reports",          "label": "Blood Reports" },
            { "value": "ecg-reports",            "label": "ECG Reports" },
            { "value": "physician-clearance",    "label": "Physician Clearance Letter" },
            { "value": "xrays-imaging",          "label": "X-rays / Medical Imaging" },
            { "value": "discharge-summary",      "label": "Hospital Discharge Summary" },
            { "value": "other",                  "label": "other" }
          ]
        },
        {
          "name": "title",
          "label": "Record Title",
          "type": "text",
          "required": true,
          "placeholder": "e.g. Post Root Canal Progress Note",
          "colSpan": 6
        },
        {
          "name": "date",
          "label": "Record Date",
          "type": "date",
          "required": true,
          "colSpan": 6
        },
        {
          "name": "content",
          "label": "Record Content",
          "type": "textarea",
          "required": true,
          "placeholder": "Enter detailed clinical notes, observations, findings...",
          "rows": 6,
          "colSpan": 12
        }
      ]
    },
    {
      "id": "attachments",
      "title": "Attachments",
      "icon": "Upload",
      "fields": [
        {
          "name": "attachments",
          "label": "Upload Files",
          "type": "file",
          "hint": "Images, reports, or documents (Max 10MB each). Accepted: JPG, PNG, PDF, DOC",
          "colSpan": 12
        }
      ]
    }
  ]
}
