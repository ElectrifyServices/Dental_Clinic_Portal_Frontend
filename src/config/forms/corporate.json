{
  "formId": "corporate",
  "version": "1.0.0",
  "title": {
    "create": "Create Membership Plan",
    "edit": "Edit Membership Plan"
  },
  "submitLabel": {
    "create": "Save Plan",
    "edit": "Save Changes"
  },
  "benefitTypes": [
    {
      "value": "flat_discount",
      "label": "Percentage Discount (All Treatments)"
    },
    {
      "value": "treatment_discount",
      "label": "Treatment-Specific Discount"
    },
    {
      "value": "free_consultations",
      "label": "Free Consultations"
    },
    {
      "value": "free_treatments",
      "label": "Free Treatments"
    },
    {
      "value": "capped_discount",
      "label": "Discount with Maximum Limit"
    },
    {
      "value": "custom",
      "label": "Custom Benefit"
    }
  ],
  "planColors": [
    {
      "value": "blue",
      "dot": "bg-blue-500"
    },
    {
      "value": "violet",
      "dot": "bg-violet-500"
    },
    {
      "value": "emerald",
      "dot": "bg-emerald-500"
    },
    {
      "value": "rose",
      "dot": "bg-rose-500"
    },
    {
      "value": "amber",
      "dot": "bg-amber-500"
    },
    {
      "value": "cyan",
      "dot": "bg-cyan-500"
    },
    {
      "value": "indigo",
      "dot": "bg-indigo-500"
    },
    {
      "value": "teal",
      "dot": "bg-teal-500"
    }
  ],
  "sections": [
    {
      "id": "coreIdentity",
      "title": "Core Identity",
      "fields": [
        {
          "name": "name",
          "label": "Plan Name",
          "type": "text",
          "required": true,
          "placeholder": "e.g. Gold Family Plan"
        },
        {
          "name": "companyName",
          "label": "Company Name",
          "type": "text",
          "required": true,
          "placeholder": "e.g. Google India Pvt Ltd"
        },
        {
          "name": "code",
          "label": "Plan Code",
          "type": "text",
          "required": true,
          "placeholder": "e.g. GOLD-2024"
        },
        {
          "name": "validFrom",
          "label": "Start Date",
          "type": "date",
          "required": true
        },
        {
          "name": "validTo",
          "label": "End Date",
          "type": "date",
          "required": true
        },
        {
          "name": "maxMembers",
          "label": "Max Members (optional)",
          "type": "number",
          "required": false,
          "placeholder": "Leave blank for no limit"
        },
        {
          "name": "description",
          "label": "Description",
          "type": "textarea",
          "required": false,
          "placeholder": "What does this plan include?",
          "rows": 2,
          "colSpan": 3
        },
        {
          "name": "color",
          "label": "Visual Branding Theme",
          "type": "select",
          "required": false
        }
      ]
    },
    {
      "id": "benefitLogic",
      "title": "Benefits",
      "fields": [
        {
          "name": "benefitType",
          "label": "Benefit Type",
          "type": "select"
        },
        {
          "name": "customName",
          "label": "Benefit Name",
          "type": "text",
          "placeholder": "e.g. Lab Charges, X-Ray"
        },
        {
          "name": "value",
          "label": "Discount %",
          "type": "number"
        },
        {
          "name": "allocationCount",
          "label": "Number of Sessions",
          "type": "number"
        },
        {
          "name": "cap",
          "label": "Maximum Amount (₹)",
          "type": "number"
        },
        {
          "name": "treatmentTypes",
          "label": "Applicable Treatments",
          "type": "checkbox"
        },
        {
          "name": "description",
          "label": "Benefit Description",
          "type": "text",
          "placeholder": "Shown to patients at billing"
        }
      ]
    }
  ]
}